{
  "rules": {
    ".read": false,
    ".write": false,
    "teams": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "username",
        "email",
        "createdAt"
      ],
      "$teamId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "passwordText": {
          ".validate": false
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false,
      ".indexOn": [
        "role",
        "teamId"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin') || root.child('teams').child($uid).exists() || root.child('referees').child($uid).exists() || root.child('organizers').child($uid).exists()",
        ".validate": "newData.hasChildren(['role']) && newData.child('role').isString()",
        "role": {
          ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin') || (auth != null && auth.uid === $uid && !data.exists())",
          ".validate": "newData.val() === 'admin' || newData.val() === 'judge' || newData.val() === 'referee' || newData.val() === 'team' || newData.val() === 'organizer'"
        }
      }
    },
    "referees": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "createdAt",
        "courtNumber"
      ],
      "$refId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "passwordText": {
          ".validate": false
        },
        "assignedRefs": {
          ".read": true,
          ".write": "auth != null"
        },
        "updatedAt": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "organizers": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "createdAt",
        "enabled"
      ],
      "$orgId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "medalDistribution": {
      ".read": true,
      "official": {
        ".read": true,
        "$categoryKey": {
          ".read": true,
          "$medalType": {
            ".read": true,
            ".write": "auth != null || root.child('organizers').child(newData.child('updatedBy').val()).exists()"
          }
        }
      },
      "expo": {
        ".read": true,
        "$categoryKey": {
          ".read": true,
          "$medalType": {
            ".read": true,
            ".write": "auth != null || root.child('organizers').child(newData.child('updatedBy').val()).exists()"
          }
        }
      }
    },
    "players": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "centerName",
        "gender",
        "age",
        "weight",
        "createdAt"
      ],
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "expoPlayers": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "centerName",
        "gender",
        "age",
        "weight",
        "createdAt"
      ],
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "playerImages": {
      ".read": true,
      ".write": true,
      "$playerId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 50000"
      }
    },
    "weighChecks": {
      ".read": true,
      "$playerId": {
        ".read": true,
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.exists()) || (!(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin') && !data.exists())",
        ".validate": "newData.hasChildren(['playerId', 'firstCheckWeight', 'submittedBy', 'submittedAt', 'locked']) && newData.child('playerId').val() === $playerId && newData.child('firstCheckWeight').isNumber() && newData.child('locked').val() === true"
      }
    },
    "formConfig": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "weightCategories": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "brackets": {
      ".read": true,
      ".indexOn": [
        "categoryType",
        "gender",
        "status",
        "createdAt"
      ],
      "$categoryKey": {
        ".read": true,
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')) || root.child('bracketAssignments').child('official').child($categoryKey).exists()"
      }
    },
    "expoBrackets": {
      ".read": true,
      "$categoryKey": {
        ".read": true,
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')) || root.child('bracketAssignments').child('expo').child($categoryKey).exists()"
      }
    },
    "expoMatchHistory": {
      ".read": true,
      "$categoryKey": {
        ".read": true,
        "$matchId": {
          ".read": true,
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')) || root.child('bracketAssignments').child('expo').child($categoryKey).exists()"
        }
      }
    },
    "currentMatch": {
      ".read": true,
      ".write": true
    },
    "matchResults": {
      ".read": true,
      ".write": true,
      "$matchId": {
        ".read": true,
        ".write": true
      }
    },
    "matchHistory": {
      ".read": true,
      ".indexOn": [
        "categoryType",
        "status",
        "savedAt"
      ],
      "$categoryKey": {
        ".read": true,
        "$matchId": {
          ".read": true,
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')) || root.child('bracketAssignments').child('official').child($categoryKey).exists()"
        }
      }
    },
    "bracketAssignments": {
      ".read": true,
      "official": {
        ".read": true,
        "$categoryKey": {
          ".read": true,
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')",
          ".validate": "newData.hasChildren(['courtNumber', 'assignedAt'])"
        }
      },
      "expo": {
        ".read": true,
        "$categoryKey": {
          ".read": true,
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')",
          ".validate": "newData.hasChildren(['courtNumber', 'assignedAt'])"
        }
      }
    },
    "championships": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "status",
        "createdAt",
        "name"
      ],
      "$championshipId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "categories": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "$categoryId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        },
        "participants": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "$participantId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        },
        "standings": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')",
          ".indexOn": [
            "rank",
            "points"
          ],
          "$standingId": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')"
          }
        },
        "medals": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "matches": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')",
          ".indexOn": [
            "categoryType",
            "status"
          ],
          "$matchId": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')"
          }
        }
      }
    },
    "championshipSettings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "scoringRules": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "pointSystem": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "overallStandings": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')",
      ".indexOn": [
        "rank",
        "points",
        "teamId",
        "championshipId"
      ],
      "$standingId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')"
      }
    },
    "categoryResults": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')",
      ".indexOn": [
        "championshipId",
        "categoryType",
        "gender"
      ],
      "$resultId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')"
      }
    },
    "liveCourts": {
      ".read": true,
      ".write": true,
      "$courtNumber": {
        ".read": true,
        ".write": true
      }
    },
    "bracketLocks": {
      ".read": true,
      "official": {
        ".read": true,
        "$categoryKey": {
          ".read": true,
          ".write": true
        }
      },
      "expo": {
        ".read": true,
        "$categoryKey": {
          ".read": true,
          ".write": true
        }
      }
    },
    "championshipHistory": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "timestamp"
      ],
      "$championshipId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}