{
  "rules": {
    ".read": true,
    ".write": true,
    "teams": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "username",
        "email",
        "createdAt"
      ],
      "$teamId": {
        ".read": true,
        ".write": true
      }
    },
    "users": {
      ".read": "auth != null",
      ".write": "true",
      ".indexOn": [
        "role",
        "teamId"
      ],
      "$uid": {
        ".read": "auth.uid === $uid || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin') || root.child('teams').child($uid).exists()",
        ".write": "auth.uid === $uid || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin') || root.child('teams').child($uid).exists()"
      }
    },
    "referees": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["createdAt", "courtNumber"],
      "$refId": {
        ".read": true,
        ".write": "auth != null",
        "assignedRefs": {
          ".read": true,
          ".write": true
        },
        "updatedAt": {
          ".read": true,
          ".write": true
        }
      }
    },
    "players": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "centerName",
        "gender",
        "age",
        "weight",
        "createdAt"
      ],
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "formConfig": {
      ".read": true,
      ".write": true
    },
    "weightCategories": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "brackets": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "categoryType",
        "gender",
        "status",
        "createdAt"
      ]
    },
    "currentMatch": {
      ".read": true,
      ".write": true
    },
    "matchResults": {
      ".read": true,
      ".write": true
    },
    "matchHistory": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "categoryType",
        "status",
        "timestamp"
      ]
    },
    "championships": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "status",
        "createdAt",
        "name"
      ],
      "$championshipId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "categories": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "$categoryId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        },
        "participants": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          "$participantId": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
          }
        },
        "standings": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')",
          ".indexOn": [
            "rank",
            "points"
          ],
          "$standingId": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')"
          }
        },
        "medals": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "matches": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')",
          ".indexOn": [
            "categoryType",
            "status"
          ],
          "$matchId": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge')"
          }
        }
      }
    },
    "championshipSettings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "scoringRules": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "pointSystem": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "overallStandings": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')",
      ".indexOn": [
        "rank",
        "points",
        "teamId",
        "championshipId"
      ],
      "$standingId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')"
      }
    },
    "categoryResults": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')",
      ".indexOn": [
        "championshipId",
        "categoryType",
        "gender"
      ],
      "$resultId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'judge' || root.child('users').child(auth.uid).child('role').val() === 'team')"
      }
    },
    "championshipHistory": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "timestamp"
      ],
      "$championshipId": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}